# ============ 微信公众号开发者配置 ============
# 登录 mp.weixin.qq.com →「设置与开发」→「基本配置」获取
# AppSecret 涉及安全，请勿泄露给他人

WECHAT_APPID=你的AppID
WECHAT_APPSECRET=你的AppSecret
AUTHOR=你的署名

# ============ 代理配置（可选） ============
# 如需使用代理访问微信 API，取消下方注释并填写
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
